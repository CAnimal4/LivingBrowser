{
  "name": "living-browser",
  "version": "0.1.0",
  "description": "Living Browser: a privacy-first, AI-native, goal-oriented personal browser MVP.",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "npm run build:main && npm run build:preload && npm run rebuild:native && electron dist/main/main.js",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.cjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "postinstall": "npm run rebuild:native",
    "lint": "tsc --noEmit && eslint .",
    "test": "npm run rebuild:node && node --import tsx --test tests/**/*.test.ts",
    "test:e2e": "npm run rebuild:native && playwright test",
    "start": "npm run rebuild:native && electron dist/main/main.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "better-sqlite3": "^11.9.1",
    "electron": "^36.4.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.53.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.53.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.29.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5"
  }
}
